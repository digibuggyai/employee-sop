generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  EMPLOYEE
  ADMIN
  SUPER_ADMIN
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  INTERN
  REMOTE_INTERN
}

model User {
  id           String @id @default(cuid())
  name         String
  email        String @unique
  passwordHash String
  role         Role   @default(EMPLOYEE)

  phone          String?
  designation    String?
  employmentType EmploymentType @default(INTERN)
  team           String?
  office         String?
  timings        String?
  birthday       DateTime?      @db.Date
  joinedOn       DateTime?      @db.Date

  mustChangePassword Boolean   @default(true)
  active             Boolean   @default(true)
  leftOn             DateTime? @db.Date
  wfhAllowance       Int       @default(4)
  weeklyHours        Int?
  leaveOpening       Float     @default(0)
  isEmployee         Boolean   @default(true)

  photoUpdatedAt DateTime?
  photo          UserPhoto?
  weeklyReports  WeeklyReport[]
  sopsWritten    Sop[]          @relation("SopAuthor")
  vaultAccess    VaultAccess[]  @relation("VaultAccessUser")
  vaultGrants    VaultAccess[]  @relation("VaultAccessGrantor")
  vaultViews     VaultView[]

  attendance Attendance[]

  tasks         Task[] @relation("TaskOwner")
  assignedTasks Task[] @relation("TaskAssigner")

  leaves         Leave[] @relation("LeaveOwner")
  reviewedLeaves Leave[] @relation("LeaveReviewer")

  corrections         AttendanceCorrection[] @relation("CorrectionOwner")
  reviewedCorrections AttendanceCorrection[] @relation("CorrectionReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Place {
  IN_OFFICE
  WFH
}

model Attendance {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  date     DateTime  @db.Date
  place    Place
  checkIn  DateTime
  checkOut DateTime?
  note     String?
  halfDay  Boolean   @default(false)
  plan     String?
  report   String?
  breaks   Break[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
}

model Break {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  start        DateTime
  end          DateTime?
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  POSTPONED
}

model Task {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("TaskOwner", fields: [userId], references: [id])

  assignedById String?
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  date        DateTime   @db.Date
  title       String
  details     String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  deadline    DateTime?  @db.Date
  link        String?
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

model Leave {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeaveOwner", fields: [userId], references: [id])

  date   DateTime    @db.Date
  reason String?
  status LeaveStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  compensatedOn DateTime? @db.Date

  emergency Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@unique([userId, compensatedOn])
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model AttendanceCorrection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CorrectionOwner", fields: [userId], references: [id])

  date     DateTime  @db.Date
  place    Place?
  checkIn  DateTime?
  checkOut DateTime?
  note     String?
  halfDay  Boolean?
  reason   String

  status       RequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("CorrectionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, date])
}

model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt
}

model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime @db.Date
  text      String
  link      String?
  fileName  String?
  fileData  Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
}

model Sop {
  id          String   @id @default(cuid())
  title       String
  team        String?
  body        String
  updatedById String
  updatedBy   User     @relation("SopAuthor", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([team])
}

model VaultColumn {
  id        String   @id @default(cuid())
  name      String
  secret    Boolean  @default(false)
  position  Int
  createdAt DateTime @default(now())
}

model VaultItem {
  id        String        @id @default(cuid())
  title     String
  cells     Json          @default("{}")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  access    VaultAccess[]
  views     VaultView[]
}

model VaultAccess {
  itemId      String
  item        VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("VaultAccessUser", fields: [userId], references: [id])
  grantedById String
  grantedBy   User      @relation("VaultAccessGrantor", fields: [grantedById], references: [id])
  createdAt   DateTime  @default(now())

  @@id([itemId, userId])
}

model VaultView {
  id     String    @id @default(cuid())
  itemId String
  item   VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])
  at     DateTime  @default(now())

  @@index([itemId, at])
}
