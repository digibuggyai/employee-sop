// The database design. Each `model` becomes a table, each line a column.
// After changing this file run:  npm run db:migrate  (updates the database + regenerates the client)

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma" // generated code lives in src/ so it gets built with the app
}

datasource db {
  provider = "postgresql"
}

// Only two roles for now: employees see their own data, admins see and manage everything.
enum Role {
  EMPLOYEE
  ADMIN // uses the Admin Panel and manages employees
  SUPER_ADMIN // everything an admin can do, plus creating and managing admin accounts (Hive Leader / Director)
}

enum EmploymentType {
  FULL_TIME
  PART_TIME // standard rules on their own (shorter) timings; no monthly leave balance
  INTERN
  REMOTE_INTERN
}

model User {
  id           String @id @default(cuid()) // unique random id, e.g. "cm3x9..."
  name         String
  email        String @unique // two people can't share an email; used to log in
  passwordHash String // NEVER the real password, only its bcrypt hash
  role         Role   @default(EMPLOYEE)

  // Profile (from the old Employee Directory sheet). "?" = optional.
  phone          String?
  designation    String?
  employmentType EmploymentType @default(INTERN)
  team           String? // Sales, Ops, Content, Marketing...
  office         String? // AVS / Digibuggy
  timings        String? // "11:00 to 18:00": the shift that late / early-leaving is measured against
  birthday       DateTime?      @db.Date
  joinedOn       DateTime?      @db.Date

  mustChangePassword Boolean   @default(true) // true until they replace the temporary password
  active             Boolean   @default(true) // false = left the company; can't log in, data kept
  leftOn             DateTime? @db.Date // last working day (set when they leave); later days aren't absences
  wfhAllowance       Int       @default(4) // WFH days per month; each WFH day beyond this counts as a half day
  weeklyHours        Int? // hours they should work each week (Mon–Sun); empty = no target set
  leaveOpening       Float     @default(0) // full-time: leave balance carried in from before the app (Oct 2026)
  isEmployee         Boolean   @default(true) // false = not tracked: no attendance, leave or WFH, never "absent" (e.g. the Hive Leader)

  // Profile photo. The image itself lives in UserPhoto (kept out of User so lists stay light);
  // this timestamp tells the app a photo exists and makes the photo's URL change when it's replaced.
  photoUpdatedAt DateTime?
  photo          UserPhoto?
  weeklyReports  WeeklyReport[]
  sopsWritten    Sop[]          @relation("SopAuthor")
  vaultAccess    VaultAccess[]  @relation("VaultAccessUser")
  vaultGrants    VaultAccess[]  @relation("VaultAccessGrantor")
  vaultViews     VaultView[]

  attendance Attendance[] // one user → many attendance days (a "relation")

  // Two relations to Task, so each needs a name: tasks I own vs tasks I assigned to others.
  tasks         Task[] @relation("TaskOwner")
  assignedTasks Task[] @relation("TaskAssigner")

  leaves         Leave[] @relation("LeaveOwner")
  reviewedLeaves Leave[] @relation("LeaveReviewer")

  corrections         AttendanceCorrection[] @relation("CorrectionOwner")
  reviewedCorrections AttendanceCorrection[] @relation("CorrectionReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Place {
  IN_OFFICE
  WFH
}

// One row per person per day: replaces a row of the attendance sheet.
model Attendance {
  id       String    @id @default(cuid())
  userId   String
  user     User      @relation(fields: [userId], references: [id]) // links to the User table
  date     DateTime  @db.Date // the day (India time), e.g. 2026-10-26
  place    Place
  checkIn  DateTime // exact moment, set by the server
  checkOut DateTime?
  note     String?
  halfDay  Boolean   @default(false) // came late / left early: present, but counts as half a working day
  plan     String? // WFH (interns): the to-do plan written at check-in
  report   String? // WFH (interns): the work report written at check-out
  breaks   Break[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // a person can't have two attendance rows for the same day
}

// Each break inside a day. end = null means "on break right now".
model Break {
  id           String     @id @default(cuid())
  attendanceId String
  attendance   Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  start        DateTime
  end          DateTime?
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  POSTPONED
}

// One task: replaces a row in someone's tab of the Task List sheet.
model Task {
  id     String @id @default(cuid())
  userId String // who does the task
  user   User   @relation("TaskOwner", fields: [userId], references: [id])

  assignedById String? // set when an admin assigned it; null = the employee added it
  assignedBy   User?   @relation("TaskAssigner", fields: [assignedById], references: [id])

  date        DateTime   @db.Date // the day it's logged for
  title       String
  details     String?
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(NOT_STARTED)
  deadline    DateTime?  @db.Date
  link        String? // drive / canva / doc link
  completedAt DateTime? // filled automatically when status becomes COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date]) // makes "this person's tasks for this month" fast
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

// One leave DAY (a 3-day request creates 3 rows, so each day can be approved or made up on its own).
model Leave {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("LeaveOwner", fields: [userId], references: [id])

  date   DateTime    @db.Date
  reason String?
  status LeaveStatus @default(PENDING)

  reviewedById String? // the admin who approved / rejected it
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  // The weekend/holiday day the person worked to make up for this leave.
  // 1 worked day covers 1 leave: the unique rule below stops one day being used twice.
  compensatedOn DateTime? @db.Date

  // Taken on the same day it was asked for (only 1 a month); all other leave is asked for in advance
  emergency Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date]) // one leave row per person per day
  @@unique([userId, compensatedOn]) // (Postgres allows many NULLs here, so un-compensated leaves are fine)
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// An employee asking to change one day's attendance (they can't edit it themselves).
// Holds only the NEW values; the current values are read from Attendance when an admin reviews it.
// Approving copies these values into the Attendance row (creating it if the day had none).
model AttendanceCorrection {
  id     String @id @default(cuid())
  userId String
  user   User   @relation("CorrectionOwner", fields: [userId], references: [id])

  date     DateTime  @db.Date
  place    Place?
  checkIn  DateTime?
  checkOut DateTime?
  note     String?
  halfDay  Boolean? // null = no change requested
  reason   String // why the change is needed (shown to the admin)

  status       RequestStatus @default(PENDING)
  reviewedById String?
  reviewedBy   User?         @relation("CorrectionReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status]) // "all pending requests" is the admin's most common question
  @@index([userId, date])
}

// A profile photo: a small square JPEG (resized to 256x256 in the browser before upload, ~20 KB).
model UserPhoto {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Bytes
  mime      String
  updatedAt DateTime @updatedAt
}

// Remote interns send a written update of their week every Saturday.
// One per person per week; weekStart is that week's Monday.
model WeeklyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  weekStart DateTime @db.Date
  text      String // required: what they did this week
  link      String? // optional: a Google Doc / Drive link
  fileName  String? // optional PDF
  fileData  Bytes?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
  @@index([weekStart])
}

// The SOP library: step-by-step "how we do things". Admins write them; everyone reads them.
model Sop {
  id          String   @id @default(cuid())
  title       String
  team        String? // Sales, Content, RMA... (filters the library)
  body        String // the steps, as plain text (one step per line)
  updatedById String
  updatedBy   User     @relation("SopAuthor", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([team])
}

// Shared logins, laid out like the sheet they came from: an admin-defined list of columns
// (VaultColumn) and one row per login (VaultItem). A row's values live in `cells`,
// keyed by column id. Values in SECRET columns (passwords, PINs...) are each ENCRYPTED with
// VAULT_KEY (backend/src/lib/vault.ts), never sent in lists, and revealed one at a time.
// Admins see every row; an employee sees only the rows they've been given access to.
model VaultColumn {
  id        String   @id @default(cuid())
  name      String
  secret    Boolean  @default(false)
  position  Int // left to right
  createdAt DateTime @default(now())
}

model VaultItem {
  id        String        @id @default(cuid())
  title     String // the row's label (its first filled column), used in lists and logs
  cells     Json          @default("{}") // { [columnId]: "value" }; secret ones are "v1:..." ciphertext
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  access    VaultAccess[]
  views     VaultView[]
}

// Who may use which login (given by an admin)
model VaultAccess {
  itemId      String
  item        VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("VaultAccessUser", fields: [userId], references: [id])
  grantedById String
  grantedBy   User      @relation("VaultAccessGrantor", fields: [grantedById], references: [id])
  createdAt   DateTime  @default(now())

  @@id([itemId, userId])
}

// Every time a password is revealed: who, which, when
model VaultView {
  id     String    @id @default(cuid())
  itemId String
  item   VaultItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id])
  at     DateTime  @default(now())

  @@index([itemId, at])
}
