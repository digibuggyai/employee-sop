PORT=4000
FRONTEND_URL=http://localhost:3000

# Railway → Postgres → Variables → DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/railway

# Secret used to sign login tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me

# Email via resend.com. Without RESEND_API_KEY, emails are printed to the terminal instead of sent.
RESEND_API_KEY=
MAIL_FROM=Digibuggy <hub@dgbindia.com>
# Link used in emails ("Log in" button)
APP_URL=http://localhost:3000

# Encrypts the shared-login passwords (Logins page). 32 random bytes, base64. Generate ONCE with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use the SAME value here and on Railway. Losing it = the stored passwords can't be read.
VAULT_KEY=
